# Secrets and credentials (keep folder, ignore contents)
secrets/*
!secrets/README.md
token.json
client_secrets.json
client_secret*.json
*.credentials

# Video files
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv

# Generated output
generated/*
!generated/.gitkeep

# Content files (keep folder structure)
content/*
!content/README.md

# Edit working dirs — keep edl.json and any committed scripts;
# ignore generated artifacts (thumbnails, previews, analyzer output, tmp segments)
edit/_tmp_segments/
edit/thumbnails/
edit/thumbnails_*/
edit/preview/
edit/preview_*/
edit/tone_test/
edit/analysis/

# Python
__pycache__/
*.py[cod]
*$py.class
.env
venv/
.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
